# Copy this file to .env and change the values. Never put .env on GitHub.

# --- on your laptop these three are enough
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- campus email endings that may register (comma separated)
STUDENT_EMAIL_DOMAINS=students.campus.ac.ke
STAFF_EMAIL_DOMAINS=campus.ac.ke

# --- used in emails: the site's address, and when items can be collected
SITE_URL=http://127.0.0.1:8000
DESK_COLLECTION_HOURS=Monday to Friday, 8:00 am to 5:00 pm

# --- live on PythonAnywhere (replace yourname)
# DEBUG=False
# ALLOWED_HOSTS=yourname.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
# SITE_URL=https://yourname.pythonanywhere.com
# DB_ENGINE=mysql
# DB_NAME=yourname$lostfound
# DB_USER=yourname
# DB_PASSWORD=your-mysql-password
# DB_HOST=yourname.mysql.pythonanywhere-services.com

# --- sending real emails (example: a Gmail account with an app password)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=lostandfound.campus@gmail.com
# EMAIL_HOST_PASSWORD=your-16-letter-app-password
# DEFAULT_FROM_EMAIL=Lost and Found <lostandfound.campus@gmail.com>
